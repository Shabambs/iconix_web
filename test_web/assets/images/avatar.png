<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1c1219"/>
      <stop offset="100%" stop-color="#0c070a"/>
    </linearGradient>
    <linearGradient id="iconGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ff4d4d"/>
      <stop offset="100%" stop-color="#800000"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background Circle -->
  <circle cx="100" cy="100" r="98" fill="url(#bgGrad)" stroke="#e60000" stroke-width="3" stroke-opacity="0.5"/>

  <!-- Inner User Silhouette Icon -->
  <g fill="url(#iconGrad)" filter="url(#glow)">
    <!-- User Head -->
    <circle cx="100" cy="78" r="32"/>
    <!-- User Shoulders -->
    <path d="M 45,160 C 45,122 70,120 100,120 C 130,120 155,122 155,160 C 155,172 145,178 100,178 C 55,178 45,172 45,160 Z"/>
  </g>
</svg>
